# system.prop for cannon
#

# MediaTek
ro.mediatek.platform=MT6853
ro.board.platform=mt6853

# Display
ro.sf.lcd_density=440
ro.product.display=Redmi Note 9 5G

# Camera
ro.product.camera=Redmi Note 9 5G

# Audio
ro.audio.silent=0

# Bluetooth
ro.bt.bdaddr_path=/sys/module/bdaddress/parameters/bdaddr

# WiFi
wifi.interface=wlan0

# GPS
ro.gps.agps_provider=1

# Telephony
ro.telephony.default_network=22,22
persist.radio.multisim.config=dsds

# Fingerprint
ro.hardware.fingerprint=goodix

# NFC
ro.hardware.nfc=mtk

# Sensors
ro.hardware.sensors=mt6853

# Charger
ro.charger.enable_suspend=true

# Build
ro.build.description=cannon-user 12 SP1A.210812.016 V13.0.1.0.SJOCNXM release-keys
ro.build.fingerprint=Redmi/cannon/cannon:12/SP1A.210812.016/V13.0.1.0.SJOCNXM:user/release-keys
