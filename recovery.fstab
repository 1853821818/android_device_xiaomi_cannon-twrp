# Mount point       Device                             FS type   Mount flags                                                            FS manager flags
/boot              /dev/block/by-name/boot            emmc      defaults                                                                 defaults
/cache             /dev/block/by-name/cache           ext4      noatime,nosuid,nodev,noauto_da_alloc,discard                      wait,check,formattable
/data              /dev/block/by-name/userdata        f2fs      noatime,nosuid,nodev,discard,inlinecrypt                            wait,check,formattable,quota,fileencryption=aes-256-xts:aes-256-cts:v1
/metadata          /dev/block/by-name/metadata        ext4      noatime,nosuid,nodev,discard                                        wait,check,formattable,first_stage_mount
/mnt/vendor/persist /dev/block/by-name/persist        ext4      noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc          wait,check,formattable
/recovery          /dev/block/by-name/recovery        emmc      defaults                                                                 defaults
/system            /dev/block/by-name/system          ext4      ro                                                                     wait,logical,first_stage_mount,avb=vbmeta_system
/vendor            /dev/block/by-name/vendor          ext4      ro                                                                     wait,logical,first_stage_mount,avb
/product           /dev/block/by-name/product         ext4      ro                                                                     wait,logical,first_stage_mount,avb
/vbmeta            /dev/block/by-name/vbmeta          emmc      defaults                                                                 defaults
/vbmeta_system     /dev/block/by-name/vbmeta_system   emmc      defaults                                                                 defaults
/vbmeta_vendor     /dev/block/by-name/vbmeta_vendor   emmc      defaults                                                                 defaults
/sdcard1           /dev/block/mmcblk1p1               auto      defaults                                                                 voldmanaged=sdcard1:auto,encryptable=userdata
/usbotg            /dev/block/sda1                     vfat      defaults                                                                 voldmanaged=usbotg:auto
